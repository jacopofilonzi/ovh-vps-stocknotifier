# Copy to .env to override the defaults: `make` and `docker compose` read it. Every variable is optional.

# Directory of config.json and state.json. Default: ./data (/data in the Docker image).
# make always uses ./temp (override with `make <target> DATA_DIR=...`), and with Docker the
# directory is the volume in docker-compose.yaml: change that instead.
# DATA_DIR=./data

# debug | info | warn | error (default: info, debug in docker-compose.dev.yaml)
# LOG_LEVEL=info

# Time zone of logs and notifications. Default: the system one (Europe/Rome in the Docker image).
# TZ=Europe/Rome
